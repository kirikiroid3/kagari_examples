//! Backgrounds, music and sound effects. Generated by `tools/gen_images.py` and
//! `tools/gen_sounds.py`; the music is from Musopen (CC0, see the repository README).

/// One background per row of the kana table, the endings and the title.
pub mod BG {
    pub const A: ImageAsset = asset("bgimage/a.png");
    pub const KA: ImageAsset = asset("bgimage/ka.png");
    pub const GA: ImageAsset = asset("bgimage/ga.png");
    pub const SA: ImageAsset = asset("bgimage/sa.png");
    pub const ZA: ImageAsset = asset("bgimage/za.png");
    pub const TA: ImageAsset = asset("bgimage/ta.png");
    pub const DA: ImageAsset = asset("bgimage/da.png");
    pub const NA: ImageAsset = asset("bgimage/na.png");
    pub const HA: ImageAsset = asset("bgimage/ha.png");
    pub const BA: ImageAsset = asset("bgimage/ba.png");
    pub const PA: ImageAsset = asset("bgimage/pa.png");
    pub const MA: ImageAsset = asset("bgimage/ma.png");
    pub const RA: ImageAsset = asset("bgimage/ra.png");
    pub const WA: ImageAsset = asset("bgimage/wa.png");
    pub const END_YA: ImageAsset = asset("bgimage/end_ya.png");
    pub const END_WO: ImageAsset = asset("bgimage/end_wo.png");
    pub const END_N: ImageAsset = asset("bgimage/end_n.png");
    pub const TITLE: ImageAsset = asset("bgimage/title.png");
}

pub mod MUSIC {
    /// Chopin, Nocturne in E-flat major, Op. 9 No. 2.
    pub const NOCTURNE: AudioAsset = asset("music/nocturne.mp3");
    /// Beethoven/Liszt, Symphony, S.464.
    pub const SYMPHONY: AudioAsset = asset("music/symphony.mp3");
}

/// Coloured noise mixed with 440 Hz – 1.2 kHz triangle waves.
pub mod SE {
    pub const CHIME: AudioAsset = asset("sound/chime.wav");
    pub const WHOOSH: AudioAsset = asset("sound/whoosh.wav");
    pub const STATIC: AudioAsset = asset("sound/static.wav");
    pub const BLIP: AudioAsset = asset("sound/blip.wav");
    pub const KNOCK: AudioAsset = asset("sound/knock.wav");
    pub const FANFARE: AudioAsset = asset("sound/fanfare.wav");
    /// A seamless 8 s loop for the ambience channel.
    pub const HUM: AudioAsset = asset("sound/hum.wav");
}
